{
  "name": "macus-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "macus": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:jev-live": "MACUS_JEV_LIVE_TEST=1 vitest run tests/jev-live.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "bench": "node dist/benchmark.js",
    "bench:paired": "node dist/paired-benchmark.js",
    "bench:snapshot": "node dist/snapshot-benchmark.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "ignore": "7.0.8",
    "proper-lockfile": "4.1.2",
    "tree-sitter": "0.21.1",
    "tree-sitter-c-sharp": "0.23.1",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-typescript": "0.23.2",
    "typebox": "1.3.27",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/config.example.yaml"
  ]
}
